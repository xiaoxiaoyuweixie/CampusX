page { background: #fff; }
.report-page { padding: 32rpx 32rpx max(40rpx, env(safe-area-inset-bottom)); color: #111827; }
.section-title { font-size: 30rpx; font-weight: 600; line-height: 44rpx; }
.required { margin-left: 8rpx; color: #ef4444; }
.reason-list { margin-top: 20rpx; }
.reason-row { display: flex; align-items: flex-start; gap: 20rpx; text-align: left; width: 100%; min-height: 76rpx; padding: 16rpx 0; margin: 0; background: #fff; border-radius: 0; font-weight: 400; font-size: 28rpx; line-height: 44rpx; color: #374151; }
.reason-row[disabled] { color: #374151; background: #fff; }
.radio-dot { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 36rpx; height: 36rpx; margin-top: 4rpx; border: 2rpx solid #d1d5db; border-radius: 50%; }
.selected .radio-dot { border-color: #3b82f6; }
.radio-inner { width: 20rpx; height: 20rpx; border-radius: 50%; background: #3b82f6; }
.reason-label { min-width: 0; }
.detail-title { margin-top: 28rpx; }
.detail-box { position: relative; margin-top: 20rpx; padding: 22rpx 24rpx 52rpx; background: #f8fafc; border: 1rpx solid #e5e7eb; border-radius: 12rpx; }
.detail-input { display: block; box-sizing: border-box; width: 100%; height: 184rpx; font-size: 28rpx; line-height: 44rpx; }
.counter { position: absolute; bottom: 16rpx; right: 24rpx; color: #9ca3af; font-size: 24rpx; }
.over-limit { border-color: #ef4444; }
.over-limit .counter { color: #b91c1c; }
.image-title { margin-top: 32rpx; }
.optional { color: #6b7280; font-size: 24rpx; font-weight: 400; }
.image-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 20rpx; }
.image-tile, .add-image { position: relative; width: 156rpx; height: 156rpx; flex-shrink: 0; }
.evidence-image { width: 100%; height: 100%; border-radius: 12rpx; background: #f3f4f6; }
.add-image { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; color: #9ca3af; background: #f8fafc; border: 1rpx dashed #d1d5db; border-radius: 12rpx; font-size: 60rpx; font-weight: 300; line-height: 1; }
.report-page button.remove-image {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 48rpx;
  height: 48rpx;
  min-width: 0;
  min-height: 0;
  max-width: none;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  color: #fff;
  background: #374151;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 48rpx;
  text-align: center;
}
.remove-image[disabled] { display: none; }
.missing-image { display: flex; flex-direction: column; justify-content: center; height: 100%; padding: 12rpx; text-align: center; color: #b45309; background: #fff7ed; border-radius: 12rpx; font-size: 22rpx; }
.image-help { margin-top: 16rpx; color: #9ca3af; font-size: 22rpx; }
.submit-button { margin-top: 56rpx; height: 88rpx; line-height: 88rpx; background: #3b82f6; color: #fff; border-radius: 12rpx; font-size: 30rpx; font-weight: 500; }
.submit-button[disabled] { background: #93baff; color: #fff; }
.page-hint, .context-error, .pending-hint { margin-bottom: 24rpx; font-size: 24rpx; line-height: 38rpx; }
.page-hint { color: #9ca3af; }
.context-error { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 20rpx; border-radius: 8rpx; color: #b45309; background: #fff7ed; }
.context-error text { flex: 1; }
.retry-button { flex-shrink: 0; padding: 0 16rpx; margin: 0; color: #3b82f6; background: transparent; font-size: 24rpx; line-height: 60rpx; }
.pending-hint { color: #6b7280; }
button::after { border: 0; }
/* 举报原因：占满内容区，靠左排列 */
.report-page button.reason-row {
  width: 100%;
  max-width: none;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 0;

  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  text-align: left;
}

/* 提交按钮：清除默认内边距，文字水平、垂直居中 */
.report-page button.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
  height: 88rpx;
  padding: 0;
  margin: 56rpx auto 0;
  line-height: normal;
  text-align: center;
}

/* 上传截图区域靠左排列 */
.report-page .image-grid {
  justify-content: flex-start;
}

/* 覆盖上传按钮的默认宽度和居中外边距 */
.report-page button.add-image {
  width: 156rpx;
  height: 156rpx;
  max-width: none;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
