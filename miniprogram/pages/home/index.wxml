<page-meta page-style="{{assistantOpen ? 'overflow: hidden;' : ''}}"></page-meta>

<view class="page">
  <view class="header">
    <view class="school">
      <image class="school-icon" src="/images/home/location.svg" mode="aspectFit" />
      <text>{{school}}</text>
    </view>
    <view class="search-wrap">
      <search-bar value="{{keyword}}" bind:input="onSearchInput" bind:confirm="onSearchConfirm" />
    </view>
    <view wx:if="{{keyword}}" class="cancel-btn" bindtap="onSearchCancel">取消</view>
  </view>

  <view class="banner">
    <image class="banner-image" src="/images/home/banner.png" mode="aspectFill" />
    <view class="banner-content">
      <view class="banner-title">校园资源 · 同学之间</view>
      <view class="banner-sub">闲置 / 教材 / 资料 / 技能</view>
    </view>
  </view>

  <view class="cat-grid">
    <view class="cat-item" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="onCategoryTap">
      <image wx:if="{{item.iconSrc}}" class="cat-icon" src="{{item.iconSrc}}" mode="aspectFit" />
      <view wx:else class="cat-icon cat-icon-fallback">{{item.icon}}</view>
      <view class="cat-name">{{item.name}}</view>
    </view>
  </view>

  <view class="section-title">推荐资源</view>
  <view class="grid">
    <view class="grid-col" wx:for="{{products}}" wx:key="id">
      <product-card product="{{item}}" variant="home" bind:producttap="onProductTap" />
    </view>
  </view>
</view>

<view
  wx:if="{{assistantReady && !assistantOpen}}"
  class="assistant-float"
  style="left: {{assistantX}}px; top: {{assistantY}}px;"
  role="button"
  aria-label="打开 CampusX AI 助手"
  catchtouchstart="onAssistantTouchStart"
  catchtouchmove="onAssistantTouchMove"
  catchtouchend="onAssistantTouchEnd"
  catchtouchcancel="onAssistantTouchCancel"
>
  <image class="assistant-float-logo" src="/images/logo.png" mode="aspectFit"></image>
</view>

<view wx:if="{{assistantOpen}}" class="assistant-overlay" bindtap="onAssistantClose">
  <view class="assistant-sheet" catchtap="onAssistantSheetTap">
    <view class="assistant-handle"></view>

    <scroll-view
      class="assistant-message-list"
      scroll-y
      scroll-with-animation
      scroll-into-view="{{assistantScrollIntoView}}"
    >
      <view
        wx:for="{{assistantMessages}}"
        wx:key="id"
        id="{{item.id}}"
        class="assistant-message assistant-message--{{item.role}}"
      >
        <image
          wx:if="{{item.role === 'assistant'}}"
          class="assistant-message-logo"
          src="/images/logo.png"
          mode="aspectFit"
        ></image>
        <view class="assistant-message-content {{item.products && item.products.length ? 'assistant-message-content--products' : ''}}">
          <view class="assistant-bubble">{{item.content}}</view>
          <view wx:if="{{item.sourceText}}" class="assistant-source">依据：{{item.sourceText}}</view>
          <view wx:if="{{item.products && item.products.length}}" class="assistant-product-list">
            <view
              wx:for="{{item.products}}"
              wx:for-item="product"
              wx:key="id"
              class="assistant-product-card"
              data-id="{{product.id}}"
              role="button"
              aria-label="查看商品 {{product.title}}"
              bindtap="onAssistantProductTap"
            >
              <image
                class="assistant-product-cover"
                src="{{product.cover}}"
                mode="aspectFill"
                lazy-load
              ></image>
              <view class="assistant-product-info">
                <view class="assistant-product-title">{{product.title}}</view>
                <view class="assistant-product-meta">
                  <text class="assistant-product-price">¥{{product.price}}</text>
                  <text class="assistant-product-location">{{product.location || product.campus || '地点待确认'}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{assistantReplying}}" id="assistant-replying" class="assistant-message assistant-message--assistant">
        <image class="assistant-message-logo" src="/images/logo.png" mode="aspectFit"></image>
        <view class="assistant-message-content">
          <view class="assistant-bubble assistant-bubble--typing">正在回复...</view>
        </view>
      </view>
    </scroll-view>

    <view class="assistant-input-bar">
      <input
        class="assistant-input"
        placeholder="问问校园资源相关问题"
        value="{{assistantInput}}"
        maxlength="200"
        confirm-type="send"
        bindinput="onAssistantInput"
        bindconfirm="onAssistantSend"
      />
      <button
        class="assistant-send"
        disabled="{{!assistantInput || assistantReplying}}"
        loading="{{assistantReplying}}"
        bindtap="onAssistantSend"
      >发送</button>
    </view>
  </view>
</view>
