page { background: #EFF6FF; }
.page { padding: 14rpx 28rpx 40rpx; }
.header { display: flex; align-items: center; gap: 28rpx; min-height: 80rpx; margin-bottom: 16rpx; }
.school { display: flex; align-items: center; gap: 17rpx; flex: 0 0 184rpx; padding-left: 26rpx; font-size: 28rpx; line-height: 34rpx; color: #111827; font-weight: 500; white-space: nowrap; }
.school-icon { width: 29rpx; height: 40rpx; flex-shrink: 0; }
.search-wrap { flex: 1; min-width: 0; }
.cancel-btn {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: #3B82F6;
  padding: 12rpx 4rpx;
}
.banner {
  position: relative;
  height: 310rpx;
  overflow: hidden;
  background: #DDEEFF;
  color: #033492;
  border-radius: 26rpx;
  margin-bottom: 34rpx;
}
.banner-image { display: block; width: 100%; height: 100%; }
.banner-content { position: absolute; top: 50rpx; left: 22rpx; right: 22rpx; }
.banner-title { font-size: 42rpx; line-height: 50rpx; font-weight: 700; }
.banner-sub { font-size: 22rpx; line-height: 28rpx; margin-top: 14rpx; }

.cat-grid {
  display: flex;
  justify-content: space-between;
  gap: 11rpx;
  margin-bottom: 32rpx;
}
.cat-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.cat-icon { width: 88rpx; height: 88rpx; flex-shrink: 0; }
.cat-icon-fallback { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.cat-name { font-size: 22rpx; line-height: 26rpx; color: #111827; text-align: center; overflow-wrap: break-word; }

.section-title {
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: #111827;
  margin: 0 0 18rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.grid-col { width: 100%; min-width: 0; }

.assistant-float {
  position: fixed;
  z-index: 80;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: transparent;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.22);
  overflow: hidden;
}

.assistant-float-logo {
  width: 100%;
  height: 100%;
  display: block;
}

.assistant-overlay {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.42);
}

.assistant-sheet {
  width: 100%;
  height: 70vh;
  max-height: 920rpx;
  display: flex;
  flex-direction: column;
  background: #F8FAFC;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}

.assistant-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 14rpx auto 10rpx;
  border-radius: 999rpx;
  background: #D1D5DB;
}

.assistant-message-list {
  flex: 1;
  min-height: 0;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.assistant-message {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.assistant-message--user {
  justify-content: flex-end;
}

.assistant-message-logo {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.assistant-message-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  max-width: 72%;
  min-width: 0;
}

.assistant-message-content--products {
  width: calc(100% - 64rpx);
  max-width: calc(100% - 64rpx);
}

.assistant-message--user .assistant-message-content {
  align-items: flex-end;
}

.assistant-bubble {
  max-width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  line-height: 1.55;
  word-break: break-all;
}

.assistant-message--assistant .assistant-bubble {
  color: #111827;
  background: #FFFFFF;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.05);
}

.assistant-message--user .assistant-bubble {
  color: #FFFFFF;
  background: #3B82F6;
  border-top-right-radius: 4rpx;
}

.assistant-bubble--typing {
  color: #6B7280 !important;
}

.assistant-source {
  margin-top: 8rpx;
  padding: 0 4rpx;
  color: #64748B;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-all;
}

.assistant-product-list {
  width: 100%;
  margin-top: 12rpx;
}

.assistant-product-card {
  width: 100%;
  min-height: 116rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.assistant-product-card:active {
  background: #F1F5F9;
}

.assistant-product-cover {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 96rpx;
  border-radius: 8rpx;
  background: #E5E7EB;
}

.assistant-product-info {
  flex: 1;
  min-width: 0;
}

.assistant-product-title {
  display: -webkit-box;
  overflow: hidden;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.assistant-product-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  min-width: 0;
}

.assistant-product-price {
  flex-shrink: 0;
  color: #DC2626;
  font-size: 27rpx;
  font-weight: 600;
}

.assistant-product-location {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #64748B;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assistant-input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E7EB;
}

.assistant-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #F1F5F9;
  font-size: 27rpx;
  color: #111827;
}
