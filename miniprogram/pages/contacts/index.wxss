page { background: #f5f5f5; }
.contacts-page { padding: 24rpx 20rpx; }
.notice { padding: 0 12rpx 32rpx; color: #999; font-size: 26rpx; line-height: 40rpx; }
.contact-section { background: #fff; margin-bottom: 24rpx; border-radius: 16rpx; overflow: hidden; }
.toggle-row { min-height: 112rpx; padding: 20rpx 32rpx; display: flex; justify-content: space-between; align-items: center; font-size: 30rpx; }
.info-row { min-height: 104rpx; margin: 0 32rpx; border-top: 1rpx solid #e6e6e6; display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; }
.field-label { flex-shrink: 0; font-size: 28rpx; color: #808080; }
.field-value { flex: 1; min-width: 0; word-break: break-all; white-space: pre-wrap; font-size: 28rpx; }
.info-row button.modify { flex: 0 0 136rpx; width: 136rpx; height: 56rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; background: #fff; color: #808080; font-size: 24rpx; line-height: 1; white-space: nowrap; border: 1rpx solid #bfbfbf; border-radius: 14rpx; }
button::after { border: 0; }
.state { color: #808080; text-align: center; padding: 32rpx; }
.retry { font-size: 28rpx; color: #385cb8; background: transparent; }
.editor { padding: 32rpx 40rpx 68rpx; background: #fff; }
.editor-title { position: relative; display: flex; align-items: center; min-height: 88rpx; padding-right: 88rpx; font-size: 36rpx; font-weight: 600; }
.editor-title button.close { position: absolute; top: 0; right: -20rpx; width: 88rpx; height: 88rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; background: transparent; color: #999; padding: 0; margin: 0; line-height: 1; font-size: 48rpx; font-weight: 400; }
.editor-label { color: #808080; font-size: 28rpx; margin-top: 24rpx; margin-bottom: 16rpx; }
.editor-input { height: 100rpx; box-sizing: border-box; padding: 0 32rpx; background: #f5f5f5; border: 3rpx solid #385cb8; border-radius: 16rpx; font-size: 32rpx; }
.editor button.confirm { width: 184px; max-width: 100%; height: 96rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin: 48rpx auto 0; padding: 0; background: #385cb8; color: #fff; font-size: 32rpx; line-height: 1; border-radius: 16rpx; }
