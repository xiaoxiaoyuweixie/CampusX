page { background: #EFF6FF; }
.wrap { display: flex; height: 100vh; background: #EFF6FF; overflow: hidden; }
.side {
  width: 180rpx;
  background: #EFF6FF;
  border-right: 1rpx solid #E5E7EB;
  padding-top: 12rpx;
}
.side-item {
  padding: 20rpx 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-left: 4rpx solid transparent;
}
.side-item.active {
  color: #3B82F6;
  background: #EFF6FF;
  border-left-color: #3B82F6;
  font-weight: 600;
}
.category-icon { width: 64rpx; height: 64rpx; flex-shrink: 0; }
.emoji { font-size: 32rpx; }
.main {
  flex: 1;
  min-width: 0;
  height: 100vh;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sort { display: flex; gap: 24rpx; padding: 8rpx 4rpx 20rpx; }
.sort-item {
  font-size: 26rpx;
  color: #6B7280;
  padding: 8rpx 0;
}
.sort-item.active { color: #3B82F6; font-weight: 600; }
.product-scroll {
  flex: 1;
  min-height: 0;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
