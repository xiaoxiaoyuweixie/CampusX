page { background: #EFF6FF; }
.page { padding: 24rpx; }
.section { padding: 24rpx; margin-bottom: 20rpx; }
.label { font-size: 26rpx; color: #6B7280; margin-bottom: 16rpx; }
.upload-section {
  padding: 32rpx; min-height: 338rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(57, 117, 181, 0.03);
}
.upload-heading {
  display: flex; align-items: baseline; gap: 12rpx;
  margin-bottom: 24rpx; line-height: 36rpx;
}
.upload-title { font-size: 30rpx; font-weight: 500; color: #111A36; }
.upload-count { font-size: 26rpx; color: #818A9E; }
.img-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-item, .img-add {
  width: 180rpx; height: 180rpx;
  border-radius: 12rpx; overflow: hidden;
  position: relative;
}
.img-item image { width: 100%; height: 100%; }
.img-del {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 36rpx; height: 36rpx; line-height: 32rpx; text-align: center;
  background: rgba(0,0,0,0.5); color: #fff; border-radius: 50%;
  font-size: 28rpx;
}
.img-add {
  background: #F2F8FE;
  border: 2rpx dashed #BBD5F6; border-radius: 16rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6rpx;
}
.img-add-empty { width: 100%; height: 210rpx; }
.upload-camera { width: 72rpx; height: 64rpx; }
.upload-copy { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.add-text { font-size: 30rpx; font-weight: 500; line-height: 36rpx; color: #347CFA; }
.upload-hint { font-size: 24rpx; line-height: 36rpx; color: #818A9E; }

.row { display: flex; align-items: center; padding: 18rpx 0; }
.row-label { width: 120rpx; font-size: 28rpx; color: #111827; }
.row-input { flex: 1; font-size: 28rpx; color: #111827; }
.picker { color: #111827; font-size: 30rpx; }
.divider { height: 1rpx; background: #F1F5F9; }

.textarea { width: 100%; min-height: 220rpx; font-size: 28rpx; }

.footer {
  padding: 20rpx 8rpx 32rpx;
  background: transparent;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}
