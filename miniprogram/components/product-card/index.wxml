<view class="card product-card {{variant === 'home' ? 'product-card-home' : ''}}" catchtap="onTap" hover-class="card-hover">
  <view wx:if="{{variant === 'home'}}" class="home-cover">
    <image class="cover" src="{{product.cover}}" mode="aspectFill" lazy-load="true" />
  </view>
  <image wx:else class="cover" src="{{product.cover}}" mode="aspectFill" lazy-load="true" />
  <view class="info">
    <view class="title">{{product.title}}</view>
    <view class="price-row">
      <text class="text-price">¥{{product.price}}</text>
      <text wx:if="{{variant !== 'home'}}" class="campus">{{product.campus}}</text>
    </view>
    <view wx:if="{{variant === 'home'}}" class="campus-row">
      <image class="campus-icon" src="/images/home/campus.svg" mode="aspectFit" />
      <text class="campus">{{product.campus}}</text>
    </view>
    <view class="meta">
      <text class="seller">{{product.sellerName}}</text>
      <text class="views">{{product.views}} 浏览</text>
    </view>
  </view>
</view>
