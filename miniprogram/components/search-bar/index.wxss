.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 34rpx;
  padding: 0 24rpx;
  height: 66rpx;
}
.icon { width: 32rpx; height: 32rpx; flex-shrink: 0; margin-right: 12rpx; }
.input { flex: 1; min-width: 0; font-size: 24rpx; color: #111827; }
.placeholder { color: #6B7280; }
